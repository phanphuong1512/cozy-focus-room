# URL của Backend Socket.IO trên Railway hoặc Render (ví dụ: https://cozy-focus-room-production.up.railway.app)
# Trên GitHub, đặt biến này tại Settings -> Secrets and variables -> Actions -> Variables -> VITE_SERVER_URL
VITE_SERVER_URL=https://your-server.up.railway.app

# Thư mục lưu dữ liệu phòng trên server (trên Railway gắn Volume /data)
DATA_DIR=/data
